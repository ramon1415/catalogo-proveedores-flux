        "definition": "CHECK (((evidence_type IS NULL) OR (evidence_type = ANY (ARRAY['whatsapp_export'::text, 'email'::text, 'signed_document'::text, 'other'::text]))))"
      },
      {
        "name": "payment_request_extraordinary_legacy_class_check",
        "type": "c",
        "definition": "CHECK ((((status = ANY (ARRAY['legacy_consumed_unverified'::text, 'legacy_quarantined'::text])) AND (legacy_previous_status = 'active'::text) AND (legacy_classified_at IS NOT NULL) AND (NULLIF(btrim(legacy_classification_reason), ''::text) IS NOT NULL)) OR ((status <> ALL (ARRAY['legacy_consumed_unverified'::text, 'legacy_quarantined'::text])) AND (legacy_previous_status IS NULL) AND (legacy_classified_at IS NULL) AND (legacy_classified_by IS NULL) AND (legacy_classification_reason IS NULL))))"
      },
      {
        "name": "payment_request_extraordinary_lifecycle_check",
        "type": "c",
        "definition": "CHECK (((status = ANY (ARRAY['legacy_consumed_unverified'::text, 'legacy_quarantined'::text, 'revoked'::text])) OR ((company_id IS NOT NULL) AND (external_director_profile_id IS NOT NULL) AND (external_authorized_at IS NOT NULL) AND (valid_until > external_authorized_at) AND (ratification_due_at > valid_until) AND (idempotency_key IS NOT NULL) AND ((char_length(idempotency_key) >= 8) AND (char_length(idempotency_key) <= 200)) AND (evidence_storage_bucket = 'extraordinary-authorizations'::text) AND (evidence_storage_path IS NOT NULL) AND (((evidence_type IS NULL) AND (evidence_sha256 IS NULL) AND (evidence_mime_type IS NULL) AND (evidence_size_bytes IS NULL) AND (evidence_verified_at IS NULL) AND (evidence_match_attested_by IS NULL) AND (evidence_match_attested_at IS NULL)) OR ((evidence_type IS NOT NULL) AND (evidence_sha256 IS NOT NULL) AND (evidence_mime_type IS NOT NULL) AND (evidence_size_bytes IS NOT NULL) AND (evidence_verified_at IS NOT NULL) AND (evidence_match_attested_by IS NOT NULL) AND (evidence_match_attested_at IS NOT NULL))) AND ((status <> ALL (ARRAY['consumed_pending_ratification'::text, 'ratified'::text, 'disputed'::text])) OR ((consumed_at IS NOT NULL) AND (consumed_layout_id IS NOT NULL) AND (consumed_layout_line_id IS NOT NULL))) AND ((status <> 'ratified'::text) OR ((ratified_by IS NOT NULL) AND (ratified_at IS NOT NULL))) AND ((status <> 'disputed'::text) OR ((disputed_by IS NOT NULL) AND (disputed_at IS NOT NULL) AND (NULLIF(btrim(dispute_reason), ''::text) IS NOT NULL))))))"
      },
      {
        "name": "payment_request_extraordinary_reason_check",
        "type": "c",
        "definition": "CHECK ((char_length(btrim(reason)) >= 20))"
      },
      {
        "name": "payment_request_extraordinary_revoke_check",
        "type": "c",
        "definition": "CHECK ((((status = 'revoked'::text) AND (revoked_by IS NOT NULL) AND (revoked_at IS NOT NULL) AND (NULLIF(btrim(revoke_reason), ''::text) IS NOT NULL)) OR ((status <> 'revoked'::text) AND (revoked_by IS NULL) AND (revoked_at IS NULL) AND (revoke_reason IS NULL))))"
      },
      {
        "name": "payment_request_extraordinary_status_check",
        "type": "c",
        "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'active'::text, 'consumed_pending_ratification'::text, 'ratified'::text, 'revoked'::text, 'expired'::text, 'disputed'::text, 'materially_invalidated'::text, 'legacy_consumed_unverified'::text, 'legacy_quarantined'::text])))"
      }
