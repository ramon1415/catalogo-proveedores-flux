      {
        "name": "payment_request_extraordinary_authorizations_file_check",
        "type": "c",
        "definition": "CHECK ((((evidence_mime_type IS NULL) AND (evidence_size_bytes IS NULL)) OR ((evidence_mime_type = ANY (ARRAY['application/pdf'::text, 'image/jpeg'::text, 'image/png'::text, 'image/webp'::text])) AND ((evidence_size_bytes >= 1) AND (evidence_size_bytes <= 5242880)))))"
      },
