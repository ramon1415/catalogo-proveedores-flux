{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build && node scripts/build-vercel-static.mjs",
  "outputDirectory": ".vercel-static",
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": false },
    { "source": "/app/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/solicitudes.html", "destination": "/solicitudes", "permanent": false },
    { "source": "/aprobaciones.html", "destination": "/aprobaciones", "permanent": false },
    { "source": "/proveedores.html", "destination": "/proveedores", "permanent": false },
    { "source": "/efectivo.html", "destination": "/efectivo", "permanent": false },
    { "source": "/pagos_comprobaciones.html", "destination": "/efectivo", "permanent": false },
    { "source": "/layouts.html", "destination": "/layouts", "permanent": false },
    { "source": "/ingresos.html", "destination": "/ingresos", "permanent": false },
    { "source": "/configuracion.html", "destination": "/configuracion", "permanent": false },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": false },
    { "source": "/approval_batches.html", "destination": "/cortes-semanales", "permanent": false },
    { "source": "/comprobantes_batch.html", "destination": "/comprobantes-batch", "permanent": false },
    { "source": "/provider_intakes.html", "destination": "/solicitudes-proveedores", "permanent": false },
    { "source": "/nomina_dispersion.html", "destination": "/nomina", "permanent": false },
    { "source": "/nomina_presupuesto.html", "destination": "/nomina", "permanent": false },
    { "source": "/nomina_qa.html", "destination": "/nomina", "permanent": false },
    { "source": "/nomina_reconciliacion.html", "destination": "/nomina", "permanent": false },
    { "source": "/pending.html", "destination": "/", "permanent": false },
    { "source": "/socios.html", "destination": "/legacy/socios.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/legacy/api/:path*", "destination": "/api/:path*" },
    { "source": "/acceso/:code", "destination": "/index.html" },
    { "source": "/solicitudes", "destination": "/index.html" },
    { "source": "/solicitudes/:path*", "destination": "/index.html" },
    { "source": "/incidencias", "destination": "/index.html" },
    { "source": "/incidencias/:path*", "destination": "/index.html" },
    { "source": "/nomina", "destination": "/index.html" },
    { "source": "/nomina/:path*", "destination": "/index.html" },
    { "source": "/proveedores", "destination": "/index.html" },
    { "source": "/proveedores/:path*", "destination": "/index.html" },
    { "source": "/aprobaciones", "destination": "/index.html" },
    { "source": "/aprobaciones/:path*", "destination": "/index.html" },
    { "source": "/cortes-semanales", "destination": "/index.html" },
    { "source": "/cortes-semanales/:path*", "destination": "/index.html" },
    { "source": "/layouts", "destination": "/index.html" },
    { "source": "/layouts/:path*", "destination": "/index.html" },
    { "source": "/comprobantes-batch", "destination": "/index.html" },
    { "source": "/comprobantes-batch/:path*", "destination": "/index.html" },
    { "source": "/efectivo", "destination": "/index.html" },
    { "source": "/efectivo/:path*", "destination": "/index.html" },
    { "source": "/ingresos", "destination": "/index.html" },
    { "source": "/ingresos/:path*", "destination": "/index.html" },
    { "source": "/solicitudes-proveedores", "destination": "/index.html" },
    { "source": "/solicitudes-proveedores/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/dashboard-anual", "destination": "/index.html" },
    { "source": "/presupuesto-anual", "destination": "/index.html" },
    { "source": "/configuracion", "destination": "/index.html" },
    { "source": "/configuracion/:path*", "destination": "/index.html" }
  ]
}
